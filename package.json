{
  "name": "jelly-keycap",
  "private": true,
  "type": "module",
  "description": "A minimal, self-hosted password manager. Svelte UI, SQLite storage, encryption in the browser.",
  "license": "MIT",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/start.js",
    "test": "node --disable-warning=ExperimentalWarning --import ./tests/support/setup.js --test tests/*.test.js",
    "desktop": "vite build && electron .",
    "package": "vite build && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "jelly-keycap.desktop",
    "productName": "Jelly Keycap",
    "files": [
      "dist/**",
      "server/**",
      "desktop/**",
      "src/media/logo-symbol.png",
      "src/media/logo-symbol.ico"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "src/media/logo-symbol.png",
    "win": {
      "icon": "src/media/logo-symbol.ico"
    }
  }
}
