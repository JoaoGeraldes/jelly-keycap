{
  "name": "vault",
  "private": true,
  "type": "module",
  "description": "A minimal, self-hosted password manager. Svelte UI, SQLite storage, encryption in the browser.",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/start.js",
    "test": "node --disable-warning=ExperimentalWarning --import ./tests/support/setup.js --test tests/*.test.js",
    "desktop": "vite build && electron .",
    "package": "vite build && electron-builder"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "vault.desktop",
    "productName": "Vault",
    "files": [
      "dist/**",
      "server/**",
      "desktop/**"
    ],
    "directories": {
      "output": "release"
    }
  }
}
